<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="StudentReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
  <parameter name="START_ID" class="java.lang.String"/><parameter name="END_ID" class="java.lang.String"/><parameter name="LOGO_STREAM" class="java.io.InputStream"/>
  <queryString><![CDATA[SELECT student_id, student_name, major, email, phone, address FROM students WHERE student_id BETWEEN $P{START_ID} AND $P{END_ID} ORDER BY student_id]]></queryString>
  <field name="student_id" class="java.lang.String"/><field name="student_name" class="java.lang.String"/><field name="major" class="java.lang.String"/><field name="email" class="java.lang.String"/><field name="phone" class="java.lang.String"/><field name="address" class="java.lang.String"/>
  <title><band height="82"><rectangle><reportElement x="0" y="0" width="782" height="75" backcolor="#E8F4F8"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle><image scaleImage="RetainShape"><reportElement x="12" y="7" width="62" height="62"/><imageExpression><![CDATA[$P{LOGO_STREAM}]]></imageExpression></image><staticText><reportElement x="85" y="14" width="500" height="30" forecolor="#0B5F7E"/><textElement><font size="22" isBold="true"/></textElement><text><![CDATA[STUDENT DATA REPORT]]></text></staticText><textField><reportElement x="85" y="45" width="500" height="18"/><textFieldExpression><![CDATA["Student ID: " + $P{START_ID} + " - " + $P{END_ID}]]></textFieldExpression></textField></band></title>
  <columnHeader><band height="30"><rectangle><reportElement x="0" y="0" width="782" height="28" backcolor="#0B5F7E"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
    <staticText><reportElement x="5" y="5" width="90" height="18" forecolor="#FFFFFF"/><textElement><font isBold="true"/></textElement><text><![CDATA[Student ID]]></text></staticText><staticText><reportElement x="100" y="5" width="130" height="18" forecolor="#FFFFFF"/><textElement><font isBold="true"/></textElement><text><![CDATA[Name]]></text></staticText><staticText><reportElement x="235" y="5" width="120" height="18" forecolor="#FFFFFF"/><textElement><font isBold="true"/></textElement><text><![CDATA[Major]]></text></staticText><staticText><reportElement x="360" y="5" width="150" height="18" forecolor="#FFFFFF"/><textElement><font isBold="true"/></textElement><text><![CDATA[Email]]></text></staticText><staticText><reportElement x="515" y="5" width="105" height="18" forecolor="#FFFFFF"/><textElement><font isBold="true"/></textElement><text><![CDATA[Phone]]></text></staticText><staticText><reportElement x="625" y="5" width="150" height="18" forecolor="#FFFFFF"/><textElement><font isBold="true"/></textElement><text><![CDATA[Address]]></text></staticText></band></columnHeader>
  <detail><band height="27"><textField><reportElement x="5" y="4" width="90" height="18"/><textFieldExpression><![CDATA[$F{student_id}]]></textFieldExpression></textField><textField><reportElement x="100" y="4" width="130" height="18"/><textFieldExpression><![CDATA[$F{student_name}]]></textFieldExpression></textField><textField><reportElement x="235" y="4" width="120" height="18"/><textFieldExpression><![CDATA[$F{major}]]></textFieldExpression></textField><textField><reportElement x="360" y="4" width="150" height="18"/><textFieldExpression><![CDATA[$F{email}]]></textFieldExpression></textField><textField><reportElement x="515" y="4" width="105" height="18"/><textFieldExpression><![CDATA[$F{phone}]]></textFieldExpression></textField><textField><reportElement x="625" y="4" width="150" height="18"/><textFieldExpression><![CDATA[$F{address}]]></textFieldExpression></textField><line><reportElement x="0" y="26" width="782" height="1" forecolor="#D7E5EA"/></line></band></detail>
